<?xml version="1.0"?>
<!--
************************************************************************
MIRA 110 R/C airplane config. This files ties together all the components
used by FGFS to represent the MIRA 110 (by Sig Mfg) including the flight
dynamics model, and external 3D model.
************************************************************************
-->

<PropertyList>
  <sim>

    <flight-model>jsb</flight-model>
    <aero>ALEDA</aero>

    <startup>
      <description>ALEDA </description>
      <author>ALEDA flight simulator </author>
      <aircraft-version>0.1</aircraft-version>
      <model-hz>400</model-hz>
      
      <splash-texture>Aircraft/ALEDA/splash.jpg</splash-texture>
      <splash-logo-image>Aircraft/ALEDA/splash-logo.png</splash-logo-image>
    </startup>

    <sound>
      <path>Aircraft/Generic/generic-sound.xml</path>
    </sound>

    <panel>
      <visibility archive="n">false</visibility>
    </panel>

    <model>
      <path archive="y">Aircraft/ALEDA/Models/ALEDA.xml</path>
    </model>

    <view>
      <internal archive="y">true</internal>
      <config>
        <x-offset-m archive="y">0.0</x-offset-m>
        <y-offset-m archive="y">0.2</y-offset-m>
        <z-offset-m archive="y">0.3</z-offset-m>
        <pitch-offset-deg>0</pitch-offset-deg>
      </config>
    </view>


    <view n="1">
    <config>
      <target-z-offset-m archive="y" type="double">0.5</target-z-offset-m>
    </config>
    </view>

    <view n="2">
    <config>
      <target-z-offset-m archive="y" type="double">0.5</target-z-offset-m>
    </config>
    </view>

    <view n="3">
    <config>
      <target-z-offset-m archive="y" type="double">0.5</target-z-offset-m>
    </config>
    </view>

    <view n="4">
    <config>
      <target-z-offset-m archive="y" type="double">0.5</target-z-offset-m>
    </config>
    </view>

    <view n="5">
    <config>
      <target-z-offset-m archive="y" type="double">0.5</target-z-offset-m>
    </config>
    </view>

    <view n="6">
    <config>
      <target-z-offset-m archive="y" type="double">0.5</target-z-offset-m>
    </config>
    </view>


    <help>
      <title>MIRA 110 (Sig Mfg)</title>
      <line>Cruise speed: 110 kts</line>
      <line>Never-exceed (Vne): 129.5 kts</line>
      <line>Best Glide (Vglide): 20 kts</line>
      <line>Maneuvering (Va): 50 kts</line>
      <line>Approach speed: 20-25 kts</line>
      <line>Stall speed (Vs): 15 kts</line>
    </help>

  </sim>

 <nasal>
  <mira>
   <file>Aircraft/ALEDA/Systems/main.nas</file>
   <file>Aircraft/ALEDA/Systems/airdata.nas</file>
<!--    <file>Aircraft/MIRA/Systems/ugear.nas</file> -->
      <script>
         setlistener("/sim/signals/fdm-initialized", func {
             var left  = screen.display.new(20, 10);
             left.add("/apm/rightaileron");
             left.add("/apm/leftaileron");
             left.add("/apm/elevator");
             left.add("/apm/rudder");
             left.add("/apm/throttle");

             var right = screen.display.new(-250, 20);
             right.add("/apm/pitch");
             right.add("/apm/roll");
             right.add("/apm/altitude");
             right.add("/apm/heading");
             right.add("/apm/airspeed");
             right.add("/apm/groundspeed");
         });
        </script>
  </mira>
 </nasal>


 <!-- <input>
   <keyboard include="MIRA-keyboard.xml"/>
 </input> -->

 <controls>
  <flight>
   <aileron-trim>0.00</aileron-trim>   <!-- fixed -->
   <elevator-trim>-0.00</elevator-trim> <!-- controllable -->
   <rudder-trim>0.00</rudder-trim>     <!-- fixed -->
  </flight>

  <gear>
   <gear-down> 1.00 </gear-down>
  </gear>


 </controls>

