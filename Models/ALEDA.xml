     <sum>
      <value> -1 </value>
      <property>gear/gear/position-norm</property>
     </sum>
     <value> -90 </value>
    </product>
  </expression>
  <axis>
    <x>0</x>
    <y>0</y>
    <z>1</z>
  </axis>
