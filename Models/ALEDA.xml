<animation>
  <object-name>FLG</object-name>
  <type>blend</type>
  <expression>
   <sum>
    <value> 1 </value>
     <product>
      <value> -1 </value>
      <property>gear/gear[1]/position-norm</property>
     </product>
    </sum>
  </expression>
  <factor>1</factor>
 </animation>


<animation>
