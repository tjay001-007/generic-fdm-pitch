  <type>rotate</type>
  <property>gear/gear/steering-norm</property>
  <factor>10</factor>
   <axis>
     <x>0</x>
     <y>1</y>
     <z>0</z>
   </axis>
  <center>
   <x-m> 0.88947</x-m>
   <y-m>0.007144</y-m>
   <z-m>-0.001102</z-m>
  </center>
 </animation>

 <animation>
